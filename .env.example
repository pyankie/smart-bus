# ── Runtime ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_PUBLIC_URL=http://localhost:3000
API_PREFIX=api
CORS_ORIGINS=*          # comma-separated in prod, e.g. https://app.example.com
IDEMPOTENCY_TTL_MS=86400000

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
AUTH_CLOCK_SKEW_SECONDS=30

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://smartbus:smartbus_dev@localhost:5432/smartbus

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_SECRET=dev-secret-change-in-prod-must-be-at-least-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-in-prod-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ── SMS / OTP ──────────────────────────────────────────────────────────────────
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_URL=https://smsethiopia.com/api/sms/send

# ── Firebase / Push Notifications ─────────────────────────────────────────────
# Get these from your Firebase console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=   # paste the key value; newlines stay as \n

# ── Payment ────────────────────────────────────────────────────────────────────
PAYMENT_WEBHOOK_SECRET=
MIN_TOPUP_AMOUNT=1000
MAX_TOPUP_AMOUNT=1000000

# Chapa
CHAPA_SECRET_KEY=
CHAPA_BASE_URL=https://api.chapa.co/v1
CHAPA_CALLBACK_URL=
CHAPA_RETURN_URL=
CHAPA_WEBHOOK_SECRET=

# ── QR Signing (PROPOSAL — confirm before tickets module) ──────────────────────
QR_SIGNING_SECRET=

# ── Jobs ───────────────────────────────────────────────────────────────────────
ENABLE_CRON=false

# ── Swagger (disable in production) ───────────────────────────────────────────
SWAGGER_ENABLED=true
